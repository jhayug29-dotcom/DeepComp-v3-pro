<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.yugz.deepcomp" ExtensionBundleVersion="2.0.0"
                   ExtensionBundleName="deepcomp panel by yugz.fx" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.yugz.deepcomp.panel" Version="2.0.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects CC 2015 (13.0) through every future release -->
            <Host Name="AEFT" Version="[13.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <!-- 6.0 keeps the panel loadable on the oldest supported CEP host.
                 Newer hosts simply run it on their newer CEP runtime. -->
            <RequiredRuntime Name="CSXS" Version="6.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.yugz.deepcomp.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--disable-web-security</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>deepcomp panel by yugz.fx</Menu>
                    <Geometry>
                        <Size>
                            <Height>560</Height>
                            <Width>300</Width>
                        </Size>
                        <MinSize>
                            <Height>300</Height>
                            <Width>210</Width>
                        </MinSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
